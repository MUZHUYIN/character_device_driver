/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>

/ {
	compatible = "raspberrypi,5-model-b", "brcm,bcm2712";
};

&spi0 {
	status = "okay";

	ili9341: ili9341@0 {
		compatible = "codex,rpi5-ili9341", "ilitek,ili9341";
		reg = <0>;
		spi-max-frequency = <32000000>;

		dc-gpios = <&rp1_gpio 24 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&rp1_gpio 25 GPIO_ACTIVE_HIGH>;
		led-gpios = <&rp1_gpio 18 GPIO_ACTIVE_HIGH>;
		te-gpios = <&rp1_gpio 23 GPIO_ACTIVE_HIGH>;

		rotation = <90>;
		bgr;
		status = "okay";
	};
};

&spidev0 {
	status = "disabled";
};
