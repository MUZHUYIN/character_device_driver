/dts-v1/;
/plugin/;

/ {
	compatible = "raspberrypi,5-model-b", "brcm,bcm2712";
};

&spi0 {
	status = "okay";

	ili9341: ili9341@0 {
		compatible = "codex,rpi5-ili9341";
		reg = <0>;
		spi-max-frequency = <32000000>;

		/*
		 * Example GPIOs for a real SPI ILI9341 panel on Raspberry Pi 5.
		 * Some modules require polarity adjustments; if the panel stays
		 * blank, try inverting dc/reset/led flags one at a time.
		 */
		dc-gpios = <&rp1_gpio 24 0>;
		reset-gpios = <&rp1_gpio 25 0>;
		led-gpios = <&rp1_gpio 18 0>;
		te-gpios = <&rp1_gpio 23 0>;

		rotation = <90>;
		bgr;
		status = "okay";
	};
};

&spidev0 {
	status = "disabled";
};
